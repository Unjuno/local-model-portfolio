    "chat_template_jinja": "{# Public translation request -> PFML3. Preserve all text whitespace. #}\n{%- macro check_text(value, name, allow_empty=false) -%}\n    {%- if value is not string -%}\n        {{- raise_exception(name + ' must be a string.') -}}\n    {%- endif -%}\n    {%- if not allow_empty and not (value | trim) -%}\n        {{- raise_exception(name + ' must not be empty.') -}}\n    {%- endif -%}\n    {%- if '<|plamo:' in value -%}\n        {{- raise_exception(name + ' must not contain reserved PFML tokens (<|plamo:...).') -}}\n    {%- endif -%}\n{%- endmacro -%}\n{%- macro check_lang(value, name) -%}\n    {{- check_text(value, name) -}}\n    {%- if value != 'ja(easy)' -%}\n        {%- set parts = value.split('-') -%}\n        {%- if parts | length > 2 or parts[0] | length not in [2, 3] or (parts | length == 2 and parts[1] | length != 4) -%}\n            {{- raise_exception(name + ' must be a lowercase language code, e.g. en, ja, zh-hans, or ja(easy).') -}}\n        {%- endif -%}\n        {%- for char in value -%}\n            {%- if char not in 'abcdefghijklmnopqrstuvwxyz-' -%}\n                {{- raise_exception(name + ' must use lowercase language codes without region subtags.') -}}\n            {%- endif -%}\n        {%- endfor -%}\n    {%- endif -%}\n{%- endmacro -%}\n{%- if messages | length == 0 or messages | length % 2 != 1 -%}\n    {{- raise_exception('Provide source/translation pairs followed by one user message.') -}}\n{%- endif -%}\n{%- for message in messages -%}\n    {%- if message is not mapping -%}\n        {{- raise_exception('Each message must contain a role and text content.') -}}\n    {%- endif -%}\n    {%- if message['role'] == 'system' -%}\n        {{- raise_exception('System messages are not supported; use context for reference text.') -}}\n    {%- endif -%}\n    {%- if (loop.index0 % 2 == 0 and message['role'] != 'user') or (loop.index0 % 2 == 1 and message['role'] != 'assistant') -%}\n        {{- raise_exception('Alternate user source text and assistant translation; end with user.') -}}\n    {%- endif -%}\n    {%- if message['tool_calls'] or message['tool_call_id'] or message['function_call'] -%}\n        {{- raise_exception('Tool calls are not supported.') -}}\n    {%- endif -%}\n    {{- check_text(message['content'], 'message content') -}}\n{%- endfor -%}\n{%- if tools or documents -%}\n    {{- raise_exception('Tool calls and documents are not supported; use context for reference text.') -}}\n{%- endif -%}\n{%- if not add_generation_prompt -%}\n    {{- raise_exception('Use add_generation_prompt=True for translation inference.') -}}\n{%- endif -%}\n{%- if target_lang is not defined -%}\n    {{- raise_exception('target_lang is required, e.g. target_lang=\"ja\".') -}}\n{%- endif -%}\n{{- check_lang(target_lang, 'target_lang') -}}\n{%- if source_lang is defined and source_lang is not none -%}\n    {{- check_lang(source_lang, 'source_lang') -}}\n{%- endif -%}\n{%- if context is defined and context is not none -%}\n    {{- check_text(context, 'context', allow_empty=true) -}}\n{%- endif -%}\n{%- if form is defined and form is not none -%}\n    {%- if form not in ['polite', 'plain'] or target_lang != 'ja' -%}\n        {{- raise_exception('form must be polite or plain and requires target_lang=\"ja\".') -}}\n    {%- endif -%}\n{%- endif -%}\n{%- if glossary is defined and glossary is not none -%}\n    {%- if glossary is not sequence or glossary is string or glossary is mapping -%}\n        {{- raise_exception('glossary must be a list of objects with source and target strings.') -}}\n    {%- endif -%}\n    {%- for term in glossary -%}\n        {%- if term is not mapping or term | length != 2 or 'source' not in term or 'target' not in term -%}\n            {{- raise_exception('Each glossary entry must contain exactly source and target.') -}}\n        {%- endif -%}\n        {{- check_text(term['source'], 'glossary source') -}}\n        {{- check_text(term['target'], 'glossary target') -}}\n    {%- endfor -%}\n{%- endif -%}\n{{- bos_token + '<|plamo:tag|>dataset<|plamo:msg|>translation' -}}\n{%- if context is defined and context -%}\n    {{- '<|plamo:tag|>context<|plamo:msg|>' + context -}}\n{%- endif -%}\n{%- for message in messages[:-1] -%}\n    {%- if message['role'] == 'user' -%}\n        {{- '<|plamo:tag|>input' -}}\n        {%- if source_lang is defined and source_lang is not none -%}\n            {{- '<|plamo:key|>lang<|plamo:val|>' + source_lang -}}\n        {%- endif -%}\n    {%- else -%}\n        {{- '<|plamo:tag|>output<|plamo:key|>lang<|plamo:val|>' + target_lang -}}\n    {%- endif -%}\n    {{- '<|plamo:msg|>' + message['content'] -}}\n{%- endfor -%}\n{%- if glossary is defined and glossary -%}\n    {{- '<|plamo:tag|>glossary' -}}\n    {%- for term in glossary -%}\n        {{- '<|plamo:index|>' + term['source'] + '<|plamo:item|>' + term['target'] -}}\n    {%- endfor -%}\n{%- endif -%}\n{{- '<|plamo:tag|>input' -}}\n{%- if source_lang is defined and source_lang is not none -%}\n    {{- '<|plamo:key|>lang<|plamo:val|>' + source_lang -}}\n{%- endif -%}\n{{- '<|plamo:msg|>' + messages[-1]['content'] + '<|plamo:tag|>output<|plamo:key|>lang<|plamo:val|>' + target_lang -}}\n{%- if form is defined and form is not none -%}\n    {{- '<|plamo:key|>form<|plamo:val|>' + form -}}\n{%- endif -%}\n{{- '<|plamo:msg|>' -}}\n"
  },
