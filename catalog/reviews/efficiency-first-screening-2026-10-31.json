  "objectives": {
    "primary": "Maximize unique useful abilities and preservation of hard-to-recreate trained knowledge under legally permitted retrieval and a fixed storage ceiling, not largest model parameter count.",
    "score_policy": "No combined numerical ranking of unrelated modalities before task-standardized evaluation. Use evidence-backed lexicographic gates and within-task Pareto comparisons.",
    "evaluation_order": [
      "legal_and_access_gate",
      "one_unique_task_or_irreplaceable_weight_evidence",
      "complete_required_bundle_and_actual_decided_file_size",
      "compare task-specific quality at matched workload, reliability, energy, peak RAM, and latency",
      "choose nondominated representative for each capability with stronger supply-loss evidence breaking ties"
    ],
    "two_bundles": [
      "preservation_bundle_original_if_irreplaceable_includes_model_weights_tokenizers_codec_configs_licenses_and_source",
      "operation_bundle_one_measured_low_precision_runtime_variant_when_needed; don't assume derived quantization can recreate high-precision original"
    ],
    "no_unjustified_benchmarks": true,
    "strictness": "A smaller model is not 'better' without same-task, same-condition quality comparison. Gated original may remain prioritized even if large. Rights, identity/voice consent, and dependencies are hard gates.",
    "required_benchmark_context": [
      "task and split; contamination checks",
      "hardware model CPU/GPU/RAM and recorded clocks/power limits",
      "OS/driver/Python ABI",
      "backend/version/quantization",
      "batch/concurrency/context length",
      "peak memory with OS/weights/KV/runtime/workspace",
      "throughput/latency/power and task-specific quality metric",
      "license and reusability constraints"
    ],
    "reserve_policy": "No pre-committed percentage quotas. Preserve protected assets first when legal rights allow; use remaining capacity on nondominated capability representatives. Projected repo size is not exact selected file size."
  },
