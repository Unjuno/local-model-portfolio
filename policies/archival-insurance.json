{
  "schema_version": 1,
  "policy_id": "ARCHIVAL_INSURANCE_V1",
  "effective_on": "2026-11-06",
  "goal": "Preserve valuable learned outcomes and reproducibility components in case public distribution channels disappear.",
  "scenario": "Hypothetical broad disappearance of public distribution, not a claim that every external copy has vanished or a ban is imminent.",
  "selection_basis": [
    "distinct learned outcome",
    "reconstruction difficulty",
    "representative capability coverage",
    "incremental complete preservation cost"
  ],
  "ordering_basis": [
    "hypothetical early-restriction capabilities and actual access changes",
    "general/frontier/specialist outcomes",
    "base models/data/runtime portability"
  ],
  "imminent_ban_evidence_required_for_selection": false,
  "probability_of_regulation_must_not_be_invented": true,
  "best_daily_runtime_required_for_archival_selection": false,
  "overall_benchmark_superiority_required_for_conditional": false,
  "negative_evidence_must_be_preserved": true,
  "public_access_does_not_make_artifact_disposable": true,
  "measured_runtime_and_complete_legal_acquisition_requirements_still_apply_when_approving": true,
  "over150b_quantized_equivalent_memory_policy_unchanged": true,
  "unknown_totals_public_metadata_only_until_resolved": true,
  "original_preferred_when_budget_permits": true,
  "quantization_loss_must_be_explicit": true,
  "one_artifact_per_learned_outcome_unless_independent_reason": true,
  "bundle_requirements": [
    "learned weights or datasets",
    "configuration/tokenizer/processor as applicable",
    "external learned dependencies",
    "runtime version/environment",
    "license/notice/provenance",
    "revision/file sizes/checksums"
  ],
  "dependency_reuse_requires_exact_identity": true,
  "critical_dependencies_accompany_first_needed_parent": true,
  "archive_target_bytes": 4000000000000,
  "minimum_free_bytes": 200000000000,
  "download_enabled": false,
  "model_execution_authorized": false,
  "paid_cloud_authorized": false,
  "stage_boundaries_do_not_prevent_cheap_unique_supporting_artifacts": true,
  "next_action": "Complete existing selected bundles before another unbounded discovery sweep."
}
